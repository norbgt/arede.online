{
  // SITE arede.online na Cloudflare (16/11/2026): arquivos estáticos, sem código rodando.
  // Arquivos estáticos não são cobrados nem limitados na Cloudflare, em nenhum plano.
  // O que sobe está em .assetsignore: só as páginas públicas. Código do servidor, notas e dados ficam só no GitHub.
  "name": "arede-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"   // 18/11 (Amanda): arede.online/@nome abre o site; quem lê o @ é o próprio site
  },
  // Só o endereço de verdade: arede.online/* (rota na zona, com "seguir para a origem" se falhar). Sem endereço provisório da Cloudflare.
  "workers_dev": false,
  "preview_urls": false
}
